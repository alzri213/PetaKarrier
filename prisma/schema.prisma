generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model JenisUsaha {
  id               String   @id
  nama             String
  kategori         String
  emoji            String
  deskripsi        String   @db.Text
  tags             String[]
  modalMin         Int
  modalMax         Int
  peralatan        Int
  bahanBakuBulanan Int
  gajiKaryawan     Int
  promosiBulanan   Int
  revenueBulanan   Int
  marginBulanan    Int
  resiko           String
  potensi          Int
  cocokUntuk       String
  createdAt        DateTime @default(now())

  analisis      Analisis[]
  rencanaBisnis RencanaBisnis[]
}

model Kota {
  id         String   @id
  nama       String
  provinsi   String
  wilayah    String   // Sumatera, Jawa, Kalimantan, Sulawesi, Maluku, Papua, Nusa Tenggara
  umr        Int
  sewaTempat Int
  utilitas   Int
  retribusi  Int
  latitude   Float?   // Koordinat untuk map
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  analisis      Analisis[]
  rencanaBisnis RencanaBisnis[]

  @@index([wilayah])
  @@index([provinsi])
}

model Provinsi {
  id         String   @id
  nama       String   @unique
  wilayah    String   // Sumatera, Jawa, Kalimantan, Sulawesi, Maluku, Papua, Nusa Tenggara
  avgUmr     Int
  minUmr     Int
  maxUmr     Int
  cityCount  Int
  topSector  String
  svgPath    String   @db.Text
  centroidX  Float
  centroidY  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([wilayah])
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  analisis Analisis[]
}

model OtpVerification {
  id             String   @id @default(cuid())
  email          String
  code           String
  expiresAt      DateTime
  sendAttempts   Int      @default(1)
  verifyAttempts Int      @default(0)
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([email, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Analisis {
  id   String @id @default(cuid())
  slug String @unique @default(cuid())

  // User relation (nullable for backward compatibility)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Profil user
  minat      String[]
  skill      String[]
  budget     Int
  waktu      String // full | parttime | sampling
  pengalaman String // pemula | pernah | sudah

  // Hasil rekomendasi (JSON)
  rekomendasi Json

  // Pilihan usaha & kota
  usahaId String?
  usaha   JenisUsaha? @relation(fields: [usahaId], references: [id])
  kotaId  String?
  kota    Kota?       @relation(fields: [kotaId], references: [id])
  skala   String? // kecil | sedang | besar

  // Hasil kalkulasi modal (JSON)
  hasilModal Json?

  // SDG Impact
  sdgImpact SdgImpact?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rencanaBisnis RencanaBisnis?
}

model RencanaBisnis {
  id         String     @id @default(cuid())
  analisisId String     @unique
  analisis   Analisis   @relation(fields: [analisisId], references: [id])
  usahaId    String
  usaha      JenisUsaha @relation(fields: [usahaId], references: [id])
  kotaId     String
  kota       Kota       @relation(fields: [kotaId], references: [id])

  kontenMd String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SdgImpact {
  id         String   @id @default(cuid())
  analisisId String   @unique
  analisis   Analisis @relation(fields: [analisisId], references: [id])

  estimasiLapanganKerja  Int    @default(0)
  potensiPendapatanLokal Int    @default(0)
  tingkatInklusivitas    String @default("menengah")
  digitalReadiness       Int    @default(0)

  createdAt DateTime @default(now())
}

model PlatformStats {
  id                 String   @id @default("global")
  totalAnalisis      Int      @default(0)
  totalRencanaBisnis Int      @default(0)
  totalEstimasiUMKM  Int      @default(0)
  totalEstimasiKerja Int      @default(0)
  updatedAt          DateTime @updatedAt
}
