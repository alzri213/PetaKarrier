# Neon PostgreSQL Connection String
# Dapatkan dari https://neon.tech → Dashboard → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Google Gemini API Key (Gratis)
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY: Google reCAPTCHA v3 (untuk anti-bot login)
# ═══════════════════════════════════════════════════════════════════════════
# Dapatkan di: https://www.google.com/recaptcha/admin/create
# 1. Pilih reCAPTCHA v3
# 2. Tambahkan domain: localhost dan domain production
# 3. Copy Site Key dan Secret Key

# Public key (digunakan di frontend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lfii6otAAAAANVAGM1e85wTZL7jLz7FxYOs8UHG"

# Secret key (digunakan di backend API untuk verify)
RECAPTCHA_SECRET_KEY="6Lfii6otAAAAAGHFgvS-LMAayASqDY1kPfKdFONK"

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL SERVICE: Nodemailer SMTP Configuration (untuk OTP)
# ═══════════════════════════════════════════════════════════════════════════
# Gunakan Gmail, Outlook, atau SMTP server custom

# --- Option 1: Gmail (Recommended) ---
# Setup: https://support.google.com/accounts/answer/185833
# 1. Aktifkan 2-Factor Authentication di akun Google
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Copy 16-digit app password (tanpa spasi)

EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"  # false untuk STARTTLS (port 587), true untuk SSL (port 465)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-digit-app-password"  # App Password dari Google

# --- Option 2: Outlook/Hotmail ---
# EMAIL_HOST="smtp-mail.outlook.com"
# EMAIL_PORT="587"
# EMAIL_SECURE="false"
# EMAIL_USER="your-email@outlook.com"
# EMAIL_PASS="your-outlook-password"

# --- Option 3: Custom SMTP Server ---
# EMAIL_HOST="smtp.your-domain.com"
# EMAIL_PORT="587"
# EMAIL_SECURE="false"
# EMAIL_USER="noreply@your-domain.com"
# EMAIL_PASS="your-smtp-password"

# ═══════════════════════════════════════════════════════════════════════════
# CATATAN PENTING
# ═══════════════════════════════════════════════════════════════════════════
# 1. Jangan commit file .env ke Git! (sudah ada di .gitignore)
# 2. Untuk testing, gunakan reCAPTCHA test keys di atas
# 3. Production: ganti dengan keys asli dari Google reCAPTCHA admin
# 4. Gmail App Password berbeda dengan password login biasa
# 5. OTP dikirim dari EMAIL_USER ke email user yang login
