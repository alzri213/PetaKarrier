# ═══════════════════════════════════════════════════════════════════════════
# DATABASE: PostgreSQL (Neon / Supabase / Local)
# ═══════════════════════════════════════════════════════════════════════════
# Neon: https://neon.tech → Dashboard → Connection Details
# Local: postgresql://postgres:postgres@localhost:5432/petakarrier?schema=public
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# ═══════════════════════════════════════════════════════════════════════════
# AI ENGINE: Google Gemini API (Gratis)
# ═══════════════════════════════════════════════════════════════════════════
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ═══════════════════════════════════════════════════════════════════════════
# AUTHENTICATION: NextAuth.js / Auth.js v5
# ═══════════════════════════════════════════════════════════════════════════
# Generate secret dengan: npx auth secret atau openssl rand -base64 32
AUTH_SECRET="your-super-secret-auth-key-min-32-chars"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-auth-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ═══════════════════════════════════════════════════════════════════════════
# OAUTH PROVIDERS (Optional untuk Login Sosial)
# ═══════════════════════════════════════════════════════════════════════════
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth: https://github.com/settings/developers
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY: Google reCAPTCHA v3 (Anti-bot Login)
# ═══════════════════════════════════════════════════════════════════════════
# Dapatkan di: https://www.google.com/recaptcha/admin/create (Pilih reCAPTCHA v3)
# Public key (Frontend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
# Secret key (Backend API)
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Alternatif Test Keys Google (Hanya untuk testing offline / bypass):
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"
# RECAPTCHA_SECRET_KEY="6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe"

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL SERVICE: Nodemailer SMTP Configuration (Untuk OTP)
# ═══════════════════════════════════════════════════════════════════════════
# --- Opsi 1: Gmail (Direkomendasikan) ---
# 1. Aktifkan 2FA di Akun Google
# 2. Generate 16-digit App Password di: https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"  # false untuk port 587 (STARTTLS), true untuk port 465 (SSL)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-digit-app-password"

# --- Opsi 2: Outlook ---
# EMAIL_HOST="smtp-mail.outlook.com"
# EMAIL_PORT="587"
# EMAIL_SECURE="false"
# EMAIL_USER="your-email@outlook.com"
# EMAIL_PASS="your-outlook-password"

# ═══════════════════════════════════════════════════════════════════════════
# CATATAN PENTING
# ═══════════════════════════════════════════════════════════════════════════
# 1. Jangan commit file .env ke Git! (sudah ada di .gitignore)
# 2. Salin file ini menjadi .env sebelum menjalankan project: cp .env.example .env
